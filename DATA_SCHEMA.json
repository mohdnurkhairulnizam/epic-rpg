  "state_management": {
    "description": "How state is managed in the application",
    "pattern": "Global state object (appState) with functions to modify",
    "persistence": {
      "method": "localStorage",
      "key": "epicRpgData",
      "format": "JSON.stringify(appState)",
      "saveFunction": "saveData()",
      "loadFunction": "loadData()",
      "triggers": "After every state modification"
    },
    "initialization": {
      "onAppStart": "Call loadData() to restore from localStorage",
      "onFirstLaunch": "If localStorage empty, initialize with preset data",
      "fallback": "If load fails, use PRESET_* constants"
    },
    "key_functions": {
      "saveData": "Saves appState to localStorage['epicRpgData']",
      "loadData": "Loads appState from localStorage['epicRpgData']",
      "addChild": "Adds new child to appState.children",
      "deleteChild": "Removes child from appState.children",
      "assignQuest": "Adds quest to child's ongoingQuests",
      "approveQuest": "Moves quest to questHistory, awards tokens",
      "rejectQuest": "Removes quest from ongoingQuests",
      "claimTreasure": "Adds treasure to activeTreasures, deducts tokens",
      "updateQMLProgress": "Increments/decrements currentQMLProgress, checks tier change",
      "changeQMLType": "Changes child's qmlType and recalculates tier",
      "updateBadgeProgress": "Increments badge progress counters",
      "checkBadgeCompletion": "Checks if badge targets met and adds to earned badges",
      "masterReset": "Clears all data and reinitializes with presets"
    }
  },
  "calculation_formulas": {
    "token_award": {
      "formula": "tokensAwarded = Math.round(baseTokenReward × ageMultiplier × (1 + qmlBonus))",
      "example": "3 × 1.2 × (1 + 0.35) = 4.86 ≈ 5 tokens",
      "components": {
        "baseTokenReward": "Quest's base reward (1-8)",
        "ageMultiplier": "Age group multiplier (0.7-1.5)",
        "qmlBonus": "QML tier bonus (0-1.0, representing 0-100%)"
      }
    },
    "age_calculation": {
      "formula": "age = Math.floor((today - dateOfBirth) / 365.25)",
      "method": "Calculate age from dateOfBirth and current date"
    },
    "tier_determination": {
      "method": "Find tier where minRequirement <= currentQMLProgress <= maxRequirement",
      "qmlType": "Determines which tier array to use (Juz Amma or Al-Quran)"
    },
    "activity_bar": {
      "formula": "totalActivity = weeklyQuests + weeklyTokens + weeklyTreasures + weeklyBadges",
      "display": "█ characters (max 10) + ░ characters (remaining)",
      "calculation": "Count stats from last 7 days of history"
    }
  },
  "data_validation": {
    "child": {
      "id": "Must be unique string",
      "name": "Must be non-empty string",
      "dateOfBirth": "Must be valid ISO date",
      "avatarId": "Must reference existing avatar file",
      "tokens": "Must be non-negative integer",
      "qmlType": "Must be 'Juz Amma' or 'Al-Quran'",
      "currentQMLTier": "Must be valid tier name",
      "currentQMLProgress": "Must be non-negative integer"
    },
    "quest": {
      "id": "Must be unique string",
      "name": "Must be non-empty string",
      "type": "Must be valid quest type",
      "baseTokenReward": "Must be integer 1-8"
    },
    "treasure": {
      "id": "Must be unique string",
      "name": "Must be non-empty string",
      "costTokens": "Must be positive integer",
      "baseTimerSeconds": "Must be positive integer"
    }
  },
  "notes": {
    "no_randomization": "All calculations are deterministic - no random number generation used",
    "no_backend": "All data stored locally in browser localStorage - no server/database",
    "no_sync": "No cloud sync or multi-device synchronization",
    "browser_dependent": "Data persists only in same browser on same device",
    "export_limitation": "No built-in export/backup functionality"
  }
}
